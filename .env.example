GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Which model provider generateJson uses. Only "gemini" exists for now.
AI_PROVIDER=gemini

# Signs the login sessions. Required in production; any long random string, e.g. `openssl rand -hex 32`.
AUTH_SECRET=

# Supabase Postgres for accounts and data. Leave empty to keep everything in .data/db.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase Realtime for duels (public Broadcast channels, no database access). The browser
# reads these, so only the publishable key goes here. Empty: duels keep polling every second.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: the user id whose board scripts/seed-demo.js fills.
DEMO_USER_ID=

# Signs the daily cron (vercel.json "crons": /api/challenge?cron=1 at 03:00 UTC, midnight in Brasilia).
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Required on Vercel; any long random string.
# Locally you can leave it empty and call http://localhost:5173/api/challenge?cron=1 by hand.
CRON_SECRET=
