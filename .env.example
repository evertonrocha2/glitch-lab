GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Which model provider generateJson uses. Only "gemini" exists for now.
AI_PROVIDER=gemini

# Supabase (production accounts and data). Leave empty to use the local JSON store and "Dev login".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# "Use demo account" signs visitors in anonymously (enable Anonymous sign-ins in Supabase Auth settings).
# Optional: a fixed account that also counts as demo, and a user id for scripts/seed-demo.js.
DEMO_EMAIL=
DEMO_USER_ID=

# Browser side (public values only, never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
